      },
      "fx": [
        {
          "type": "tapeStack",
          "enabled": true,
          "params": {
            "format": "vhs",
            "generation": 2,
            "wear": 0.5,
            "events": 0.08,
            "eventList": "signal",
            "overwrite": 0,
            "mood": 0.1,
            "seed": 0
          }
        }
      ],
      "blend": "normal",
      "opacity": 1,
      "modulators": []
