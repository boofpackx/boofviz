      "name": "Archive footage",
      "enabled": true,
      "source": {
        "type": "generator",
        "kind": "archiveFootage",
        "params": {
          "collection": "ephemeral",
          "channels": "",
          "decade": "any",
          "search": "",
          "yearFrom": 1930,
          "yearTo": 2002,
          "changeBars": 8,
          "jumpBeats": 1,
          "skip": 0,
          "fit": "cover",
          "punch": 0.6,
          "switchStatic": 0
