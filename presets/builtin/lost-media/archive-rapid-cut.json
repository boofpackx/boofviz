{
  "schema": 1,
  "name": "Rapid Cut Archive",
  "category": "Lost Media",
  "tags": [
    "archive",
    "found footage",
    "lost media",
    "real footage",
    "montage",
    "fast",
    "vhs",
    "music video",
    "lyrics",
    "words",
    "karaoke"
  ],
  "energy": 5,
  "palette": "Custom",
  "paletteCycle": {
    "mode": "off",
