          "path": "layers.1.fx.0.params.wear",
          "range": [
            0,
            2
          ]
        }
      ]
    },
    {
      "name": "Tape events",
      "value": 0.25,
      "targets": [
        {
          "path": "layers.1.fx.0.params.events",
          "range": [
            0,
            1
          ]
        }
