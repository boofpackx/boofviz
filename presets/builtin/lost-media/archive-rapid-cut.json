      "opacity": 1,
      "modulators": []
    },
    {
      "id": "age",
      "name": "Age",
      "enabled": true,
      "source": {
        "type": "generator",
        "kind": "adjust",
        "params": {}
      },
      "fx": [
        {
          "type": "tapeStack",
          "enabled": true,
          "params": {
            "format": "vhs",
            "generation": 2,
            "wear": 0.7,
            "events": 0.3,
            "eventList": "eat,rewind,ffwd,signal",
            "overwrite": 0,
            "mood": 0.2,
            "seed": 19
          }
        }
      ],
      "blend": "normal",
      "opacity": 1,
      "modulators": []
    },
    {
      "id": "text",
      "name": "Lyrics & labels",
      "enabled": true,
