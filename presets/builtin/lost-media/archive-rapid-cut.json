          "safe43": false,
          "date": "JUN 14 1994",
          "station": "CHANNEL 9",
          "title": "",
          "ticker": "",
          "events": 0,
          "eventList": "all",
          "seed": 0,
          "lead": 150
        }
      },
      "fx": [],
      "blend": "normal",
      "opacity": 1,
      "modulators": []
    }
  ],
  "macros": [
    {
      "name": "Lyrics on",
      "value": 1,
      "targets": [
        {
          "path": "layers.2.source.params.lyrics",
          "range": [
            0,
            1
          ]
        }
      ]
    },
    {
      "name": "Next clip",
      "value": 0,
