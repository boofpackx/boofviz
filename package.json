{
  "name": "boofviz",
  "productName": "BOOFVIZ",
  "version": "0.2.0",
  "description": "Real-time audio visualizer and auto-VJ",
  "author": "BOOFVIZ",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "smoke": "node scripts/smoke.mjs",
    "link:e2e": "node scripts/link-e2e.mjs",
    "lyrics:e2e": "node scripts/lyrics-e2e.mjs",
    "lyrics:smtc:e2e": "node scripts/lyrics-smtc-e2e.mjs",
    "soak": "node scripts/soak.mjs",
    "make-test-track": "node scripts/make-test-track.mjs test-output/test-128bpm.wav",
    "presets:format": "esbuild scripts/format-presets.ts --tsconfig=tsconfig.node.json --bundle --platform=node --format=esm --log-level=warning --outfile=out/tools/format-presets.mjs && node out/tools/format-presets.mjs",
    "presets:check": "esbuild scripts/format-presets.ts --tsconfig=tsconfig.node.json --bundle --platform=node --format=esm --log-level=warning --outfile=out/tools/format-presets.mjs && node out/tools/format-presets.mjs --check",
    "tour": "node scripts/preset-tour.mjs",
    "archive:e2e": "node scripts/archive-e2e.mjs",
    "link:build": "node scripts/build-link.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.5.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.boofviz.app",
    "productName": "BOOFVIZ",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/tools/**",
      "!out/.tsc-*/**",
      "package.json",
      "native/link/build/Release/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BOOFVIZ-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "native/link/build/Release/*.node"
    ]
  }
}
